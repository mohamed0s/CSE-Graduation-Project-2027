# Provider selection: openai_compat, gemini_native, or chatgpt_http
LLM_PROVIDER=

# OpenAI-compatible endpoint (also used for Gemini's OpenAI-compatible URL)
LLM_BASE_URL=
LLM_API_KEY=

# Model name (e.g. gemini-3.8-flash for the native Gemini API)
LLM_MODEL=

# Gemini native client timeout in seconds (SDK http_options uses milliseconds).
GEMINI_TIMEOUT_SECONDS=120

# Internal ChatGPT HTTP server, used when LLM_PROVIDER=chatgpt_http.
# CHATGPT_API_KEY is optional. Do not put a real URL or key here.
CHATGPT_URL=
CHATGPT_API_KEY=
CHATGPT_TIMEOUT_SECONDS=30

# Jev (TypeSafe) intent classifier. Always pin a versioned ID, never jev-latest in production.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=10

# Intent classifier: jev or gemini. No default; must be set.
CLASSIFIER_PROVIDER=
# 0.7 was chosen from scripts/run_classifier_eval.py on 64 rows with jev-1.13.0
# (100% accuracy on accepted rows, 7.8% fallback). 0.6 is a guess that has not
# been measured. Re-run the eval after any change to the criteria or the Jev model.
CONFIDENCE_THRESHOLD=0.7
GROUP_THRESHOLD=0.6

# Minimum RAG score for an app-help answer. Below this, the fixed template is used.
APP_HELP_MIN_SCORE=0.0

# Reliability. Defaults apply when a value is blank.
# Breaker opens after this many consecutive AIServiceError or timeout failures,
# stays open for the cooldown, then allows one trial call.
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# Whole POST /parse budget. Past this, the work is cancelled.
REQUEST_TIMEOUT_SECONDS=25
# In-memory limit per X-User-Id. Requests with no header share one anonymous bucket.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
