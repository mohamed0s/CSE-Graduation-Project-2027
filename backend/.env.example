# FINDA Backend Environment Variables Example
# Copy to .env in backend/ (never commit real secrets; .env is git-ignored)

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Local Docker PostgreSQL + PostGIS (used by backend/docker-compose.yml)
POSTGRES_USER=finda
POSTGRES_PASSWORD=finda_dev_password
POSTGRES_DB=finda_dev
POSTGRES_PORT=5432

# Backend Connection String (matches Docker Compose defaults above)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=finda_dev;Username=finda;Password=finda_dev_password
AI_SERVICE_URL=http://localhost:8000

# JWT Settings (use at least 32 characters for Secret)
Jwt__Secret=REPLACE_WITH_AT_LEAST_32_CHARACTER_SECRET_KEY_FOR_DEV
Jwt__Issuer=finda-api
Jwt__Audience=finda-clients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

Cors__AllowedOrigins__0=http://localhost:3000
