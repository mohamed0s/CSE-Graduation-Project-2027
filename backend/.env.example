# FINDA Backend Environment Variables Example
# Copy to .env or configure via dotnet user-secrets / appsettings.Development.json (never commit real secrets)

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

ConnectionStrings__Default=Host=localhost;Port=5432;Database=finda;Username=postgres;Password=postgres
AI_SERVICE_URL=http://localhost:8000

Jwt__Secret=REPLACE_WITH_AT_LEAST_32_CHARACTER_SECRET_KEY_FOR_DEV
Jwt__Issuer=finda-api
Jwt__Audience=finda-clients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

Cors__AllowedOrigins__0=http://localhost:3000
